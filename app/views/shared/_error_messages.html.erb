<% if resource&.errors&.any? %>
  <div class="mb-6 p-4 bg-error-container rounded-xl">
    <div class="flex items-start gap-3">
      <svg class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3.75h.008v.008H12v-.008ZM12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18Z" />
      </svg>

      <div>
        <h3 class="text-sm font-bold tracking-wider text-on-error-container">
          入力内容に<%= resource.errors.size %>件の誤りがあります。該当の箇所を確認してください。
        </h3>
        <ul class="mt-2 space-y-1 text-xs text-gray-700 font-semibold tracking-wide">
          <% resource.errors.full_messages.each do |message| %>
            <li class="flex items-start gap-2">
              <span class="w-1.5 h-1.5 bg-error rounded-full flex-shrink-0 mt-1.5"></span>
              <span class="flex-1"><%= message %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
