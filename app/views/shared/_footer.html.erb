<footer class="bg-surface-container py-16 border-t border-outline-variant/20">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="col-span-1 md:col-span-1">
      <%= link_to 'SENTO GUIDE' , root_path, class: 'font-family-display text-headline-sm text-on-surface mb-4 block font-bold tracking-tight' %>
      <p class="text-on-surface-variant text-label-sm leading-relaxed">都会の喧騒を忘れ、心身を浄化する。スーパー銭湯と日本の風呂文化をキュレーションします。</p>
    </div>
    <div class="col-span-1">
      <h5 class="footer-h5">リソース</h5>
      <ul class="space-y-4">
        <li><%= link_to '施設の種類と特徴' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
        <li><%= link_to 'サウナの嗜み方' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
        <li><%= link_to '岩盤浴ガイド' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
      </ul>
    </div>
    <div class="col-span-1">
      <h5 class="footer-h5">施設を探す</h5>
      <ul class="space-y-4">
        <li><%= link_to 'エリアから探す' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
        <li><%= link_to 'こだわり条件から探す' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
      </ul>
    </div>
    <div class="col-span-1">
      <h5 class="footer-h5">運営</h5>
      <ul class="space-y-4">
        <li>
          <%= link_to '私たちについて（開発者紹介）' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %>
        </li>
        <li><%= link_to '掲載依頼 / お問い合わせ' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %></li>
        <li>
          <%= link_to '利用規約 / プライバシーポリシー' , '#' , class: 'text-on-surface-variant hover:underline decoration-secondary transition-all text-label-sm' %>
        </li>
      </ul>
    </div>
  </div>
  <div class="mt-16 pt-8 border-t border-outline-variant/10 text-center px-margin-mobile">
    <p class="text-on-surface-variant text-label-sm">© 2026 Sento Guide. All rights reserved.</p>
  </div>
</footer>
