<!-- Temperature Selection Callout -->
<section class="mb-24 px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
  <div class="bg-primary-container p-12 md:p-20 rounded-3xl relative overflow-hidden text-center text-on-primary">
    <div
      class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white to-transparent">
    </div>
    <div class="relative z-10 max-w-2xl mx-auto">
      <h2 class="font-headline-md text-headline-md mb-6">あなた好みの温度と設備を探す</h2>
      <p class="font-body-md text-body-md mb-10 opacity-90">
        15℃の水風呂から、45℃のあつ湯、そして50℃前後のじっくり温まる岩盤浴まで。あなたの今日の気分にぴったりの施設が見つかります。</p>
      <div class="flex flex-col gap-6 mb-12">
        <div class="flex justify-between text-label-sm font-label-sm uppercase tracking-widest opacity-80">
          <span>低中温（岩盤浴・サウナ）</span>
          <span>高温（天然温泉）</span>
        </div>
        <div class="heat-gauge w-full"></div>
        <div class="flex justify-center gap-6 flex-wrap">
          <span class="flex items-center gap-2 text-label-md">
            <div class="w-3 h-3 rounded-full bg-surface"></div> 冷水風呂
          </span>
          <span class="flex items-center gap-2 text-label-md">
            <div class="w-3 h-3 rounded-full bg-secondary-fixed"></div> 岩盤浴
          </span>
          <span class="flex items-center gap-2 text-label-md">
            <div class="w-3 h-3 rounded-full bg-secondary"></div> 薬湯・高濃度炭酸泉
          </span>
        </div>
      </div>
      <button
        class="bg-white text-primary px-10 py-4 rounded-full font-bold hover:scale-105 transition-all shadow-lg">設備・サービスから絞り込む</button>
    </div>
  </div>
</section>
